spring.application.name=vector-store-loader
server.port=0
spring.ai.vectorstore.qdrant.initialize-schema=true
spring.ai.vectorstore.qdrant.collection-name=BookContent
spring.ai.ollama.embedding.options.model=nomic-embed-text
spring.ai.ollama.chat.options.model=llama3.2



spring.cloud.function.definition=fileSupplier|documentReader|splitter|titleDeterminer|vectorStoreConsumer
    
file.supplier.directory=/home/chkpr/book-dropoff
file.supplier.filename-regex=.*\.(pdf|docx|txt)

logging.level.org.springframework.cloud.function=DEBUG
